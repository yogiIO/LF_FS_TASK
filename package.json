    "start": "node backend_express.js",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch backend_express.js",
    "dev:web": "vite",
    "build": "vite build",
